# ==========================================
# Database (PostgreSQL)
# ==========================================
# Lihat README bagian "Setup Database" untuk cara membuat role & database.
DATABASE_URL="postgresql://shopee:shopee_dev_password@localhost:5432/shopee_mvp?schema=public"

# Opsional.-Isi hanya jika memakai hosting ber-pool (Neon/Supabase):
# DIRECT_DATABASE_URL="postgresql://user:pass@host/db?schema=public"
# SHADOW_DATABASE_URL="postgresql://user:pass@host/shadow_db?schema=public"

# ==========================================
# Aplikasi
# ==========================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==========================================
# Auth.js / NextAuth v5
# ==========================================
# Isi dengan: npx auth secret
AUTH_SECRET=""

# Diperlukan agar Auth.js percaya pada host reverse proxy / Vercel.
AUTH_TRUST_HOST="true"

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Alias NextAuth v4 (dipakai sebagai fallback otomatis oleh v5)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET=""

# ==========================================
# Penyimpanan gambar produk (lokal)
# ==========================================
UPLOAD_DIR="./public/uploads"
MAX_UPLOAD_SIZE_MB="5"

# ==========================================
# Pembayaran
# ==========================================
# MVP: "dummy" (tanpa gateway, order langsung diproses / COD)
PAYMENT_PROVIDER="dummy"
